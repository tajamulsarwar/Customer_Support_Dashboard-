# Copy this file to  .env  and paste your own Supabase connection string.
#
# Where to find it:
#   supabase.com -> your project -> Project Settings -> Database
#   -> Connection string -> URI  -> choose "Session pooler"
#
# Replace [YOUR-PASSWORD] with the database password you set when
# you created the project.
#
# Leave .env missing entirely to keep using the local SQLite file.

DATABASE_URL=postgresql://postgres.abcdefghijk:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# Which language model answers the hard messages: auto, ollama, claude or none.
LLM_BACKEND=ollama
OLLAMA_MODEL=qwen2.5:7b

# Only needed if LLM_BACKEND=claude. Get a key at console.anthropic.com.
# ANTHROPIC_API_KEY=sk-ant-...

# LangSmith tracing. Set to false to send nothing. Get a key at smith.langchain.com.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=customer-support
